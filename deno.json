{
	"tasks": {
		"build": "deno run --allow-read=. --allow-write=build --allow-net build.ts",
		"serve": "deno task build && deno run --allow-net --allow-read --allow-sys jsr:@std/http/file-server build"
	},
	"imports": {
		"@lambdaurora/libhtml": "jsr:@lambdaurora/libhtml@^1.3.2",
		"@lambdaurora/libmd": "jsr:@lambdaurora/libmd@^2.3.1",
		"@std/fs": "jsr:@std/fs@^1.0.19",
		"flexver": "npm:flexver@^1.1.1"
	},
	"fmt": {
		"lineWidth": 160,
		"useTabs": true,
		"exclude": ["index.in.html", "*.md", "*.css"]
	}
}
